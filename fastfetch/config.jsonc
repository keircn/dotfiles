{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " ",
    "color": {
      "keys": "cyan",
      "title": "light_yellow"
    },
    "key": {
      "paddingLeft": 2
    },
    "bar": {
      "border": {
        "left": "",
        "right": ""
      },
      "width": 10,
      "color": {
        "elapsed": "auto",
        "total": "90"
      }
    },
    "percent": {
      "type": 2
    }
  },
  "modules": [
    "title",
    {
      "type": "separator"
    },
    {
      "type": "os",
      "key": " OS       >",
      "format": "{1} {2}"
    },
    {
      "type": "kernel",
      "key": " Kernel   >"
    },
    {
      "type": "uptime",
      "key": " Uptime   >"
    },
    {
      "type": "packages",
      "key": "󰏗 Packages >"
    },
    {
      "type": "shell",
      "key": " Shell    >"
    },
    {
      "type": "wm",
      "key": " WM       >"
    },
    {
      "type": "locale",
      "key": "󱌥 Locale   >"
    },
    {
      "type": "terminal",
      "key": " Terminal >"
    },
    {
      "type": "terminalfont",
      "key": " Font     >"
    },
    {
      "type": "display",
      "key": "󰍹 Display  >"
    },
    {
      "type": "sound",
      "key": " Sound    >"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU      >",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "󰾲 GPU      >"
    },
    {
      "type": "memory",
      "key": " Memory   >"
    },
    {
      "type": "disk",
      "key": " Disk /   >",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": "󱎟 Games    >",
      "folders": "/mnt/games"
    },
    {
      "type": "localip",
      "key": "󰩟 IP       >"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 3
    }
  ]
}
