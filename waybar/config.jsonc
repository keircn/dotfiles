{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,

  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "disk",
    "pulseaudio",
    "network",
    "idle_inhibitor",
    "tray"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4]
    }
  },

  "sway/mode": {
    "format": "{}"
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y\n%H:%M:%S}"
  },

  "cpu": {
    "interval": 2,
    "format": "cpu {usage}%",
    "tooltip": false
  },

  "memory": {
    "interval": 5,
    "format": "mem {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },

  "temperature": {
    "interval": 5,
    "thermal-zone": 0,
    "critical-threshold": 80,
    "format": "temp {temperatureC}°C",
    "format-critical": "temp {temperatureC}°C"
  },

  "disk": {
    "interval": 30,
    "path": "/",
    "format": "disk {percentage_used}%",
    "tooltip-format": "{used} used / {total} total"
  },

  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol muted",
    "format-icons": {
      "default": ["low", "mid", "high"]
    },
    "on-click": "pavucontrol"
  },

  "network": {
    "interval": 5,
    "format-ethernet": "eth {ipaddr}",
    "format-wifi": "wifi {essid}",
    "format-disconnected": "offline",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nup {bandwidthUpBits} down {bandwidthDownBits}",
    "tooltip-format-wifi": "{ifname}: {essid} {signalStrength}%\n{ipaddr}/{cidr}"
  },

  "idle_inhibitor": {
    "format": "{status}",
    "format-icons": {
      "activated": "awake",
      "deactivated": "idle"
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
