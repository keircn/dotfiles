{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left": ["sway/workspaces", "custom/clock", "idle_inhibitor"],
    "modules-center": ["sway/mode"],
    "modules-right": ["pulseaudio", "cpu", "memory", "tray"],

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "custom/clock": {
        "exec": "/home/keiran/.config/waybar/modules/clock.sh",
        "interval": 1,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "muted",
        "scroll-step": 1,
        "on-click-right": "pavucontrol"
    },

    "cpu": {
        "interval": 5,
        "format": "{usage}%  ({load})",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "memory": {
        "interval": 30,
        "format": "{used:0.1f}G  /  {total:0.1f}G"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
